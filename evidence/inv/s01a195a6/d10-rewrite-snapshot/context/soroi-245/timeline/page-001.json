          "url": "https://api.github.com/repos/Pepgent/soroi/pulls/246",
          "html_url": "https://github.com/Pepgent/soroi/pull/246",
          "diff_url": "https://github.com/Pepgent/soroi/pull/246.diff",
          "patch_url": "https://github.com/Pepgent/soroi/pull/246.patch",
