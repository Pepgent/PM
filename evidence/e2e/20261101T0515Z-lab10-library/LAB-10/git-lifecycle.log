            "source": "async (label: string, duration_ms: number = 1000) => {\n  if (!/^[A-Za-z0-9_-]{1,128}$/.test(label)) throw new Error(\"label must contain 1–128 ASCII letters, digits, underscores or hyphens\");\n  if (!Number.isFinite(duration_ms) || duration_ms < 0) throw new Error(\"duration_ms must be finite and nonnegative\");\n  const markers = \"/var/tmp/soroi-e2e/remote-markers\";\n  await mkdir(markers, { recursive: true });\n  await Bun.write(`${markers}/${label}`, `${JSON.stringify({ label, duration_ms })}\\n`);\n  console.log(`slow_step started: ${label} (${duration_ms} ms)`);\n  await Bun.sleep(duration_ms);\n  console.log(`slow_step finished: ${label}`);\n  return { label: `staged:${label}`, duration_ms };\n}"
          },
